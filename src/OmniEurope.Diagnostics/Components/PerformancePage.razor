@namespace OmniEurope.Diagnostics.Components
@* The page MapOmniPerformance answers with: a complete HTML document, no stylesheet, no script, the figures of
   OmniPerformanceView in semantic HTML without a single class or style. The page is rendered statically, once per
   request; reloading it reads the figures again. A host that wants its own look places OmniPerformanceView in its
   own page, or renders RequestPerformanceRecorder.Summarize() itself. *@
<!DOCTYPE html>
<html lang="@Language">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>@L["Title"]</title>
</head>
<body>
    <main>
        <h1>@L["Title"]</h1>
        <OmniPerformanceView />
    </main>
</body>
</html>
