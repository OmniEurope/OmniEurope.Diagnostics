<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <!-- Every public member carries an XML doc (CS1591 is an error under TreatWarningsAsErrors). -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>OmniEurope.Diagnostics</PackageId>
    <Version>1.0.0</Version>
    <Authors>OmniEurope contributors</Authors>
    <Company>OmniEurope</Company>
    <Description>Minimal, unstyled ASP.NET Core diagnostics pages for the site they are mounted in: a request performance page (the slowest calls and per-route percentiles over a configurable window, with a collector memory budget of 2 MiB by default) and an application logs page over the host's Serilog JSON files (filters, exclusion rules, CSV export, purge).</Description>
    <PackageTags>aspnetcore;blazor;performance;diagnostics;logs;serilog;eupl</PackageTags>
    <PackageLicenseExpression>EUPL-1.2</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/OmniEurope/OmniEurope.Diagnostics</RepositoryUrl>
    <PackageProjectUrl>https://github.com/OmniEurope/OmniEurope.Diagnostics</PackageProjectUrl>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
    <IsPackable>true</IsPackable>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <!-- The texts of Resources/*Strings.resx are French; English ships as a satellite. -->
    <NeutralLanguage>fr</NeutralLanguage>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <!-- The recorder listens to the ASP.NET Core hosting metrics and the page is an endpoint result:
         the package targets an ASP.NET Core host, never a standalone WebAssembly app. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
</Project>
